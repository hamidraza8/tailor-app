# Database
POSTGRES_DB=tailorshop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password

# Backend
DATABASE_CONNECTION=Host=postgres;Database=tailorshop;Username=postgres;Password=change-this-strong-password
JWT_SECRET=change-this-to-a-very-long-random-secret-string-at-least-32-chars
JWT_ISSUER=TailorShop
JWT_AUDIENCE=TailorShop

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads
STORAGE_BASE_URL=/api/files

# SMTP (Brevo free tier - 300 emails/day)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-user
SMTP_PASSWORD=your-brevo-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Ladies Tailoring & Garments

# Domain
PUBLIC_URL=https://yourdomain.com
